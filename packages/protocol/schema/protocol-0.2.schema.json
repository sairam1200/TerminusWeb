{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.invalid/contracts/protocol-0.2.schema.json",
  "title": "Terminus private terminal protocol 0.2",
  "description": "Closed remembered-session frame vocabulary; direction, offsets, timing, ownership, replay, and transitions are enforced by companion contracts.",
  "oneOf": [
    { "$ref": "#/$defs/helloFrame" },
    { "$ref": "#/$defs/helloAckFrame" },
    { "$ref": "#/$defs/pairingRequestFrame" },
    { "$ref": "#/$defs/pairingResultFrame" },
    { "$ref": "#/$defs/authChallengeFrame" },
    { "$ref": "#/$defs/authResponseFrame" },
    { "$ref": "#/$defs/authResultFrame" },
    { "$ref": "#/$defs/openSessionFrame" },
    { "$ref": "#/$defs/sessionOpenedFrame" },
    { "$ref": "#/$defs/reopenSessionFrame" },
    { "$ref": "#/$defs/sessionReopenedFrame" },
    { "$ref": "#/$defs/historyBeginFrame" },
    { "$ref": "#/$defs/historyChunkFrame" },
    { "$ref": "#/$defs/historyEndFrame" },
    { "$ref": "#/$defs/terminalInputFrame" },
    { "$ref": "#/$defs/terminalOutputFrame" },
    { "$ref": "#/$defs/resizeFrame" },
    { "$ref": "#/$defs/heartbeatFrame" },
    { "$ref": "#/$defs/detachFrame" },
    { "$ref": "#/$defs/sessionDetachedFrame" },
    { "$ref": "#/$defs/closeSessionFrame" },
    { "$ref": "#/$defs/sessionClosedFrame" },
    { "$ref": "#/$defs/errorFrame" }
  ],
  "$defs": {
    "uuidV4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sessionId": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{4}-[0-9a-hjkmnp-tv-z]{4}-[0-9a-hjkmnp-tv-z]{4}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "offset": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "base64url16": { "type": "string", "minLength": 22, "maxLength": 22, "pattern": "^[A-Za-z0-9_-]{22}$" },
    "base64url32": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$" },
    "base64urlData": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$" },
    "dimensions": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "baseFrame": {
      "type": "object",
      "required": ["version", "type", "connectionId", "sequence", "payload"],
      "properties": {
        "version": { "const": "0.2" },
        "type": {
          "enum": [
            "hello", "hello_ack", "pairing_request", "pairing_result",
            "auth_challenge", "auth_response", "auth_result", "open_session",
            "session_opened", "reopen_session", "session_reopened",
            "history_begin", "history_chunk", "history_end", "terminal_input",
            "terminal_output", "resize", "heartbeat", "detach",
            "session_detached", "close_session", "session_closed", "error"
          ]
        },
        "connectionId": { "$ref": "#/$defs/uuidV4" },
        "sequence": { "$ref": "#/$defs/offset" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "helloPayload": {
      "type": "object",
      "required": ["clientInstanceId", "supportedVersions"],
      "properties": {
        "clientInstanceId": { "$ref": "#/$defs/uuidV4" },
        "credentialId": { "$ref": "#/$defs/uuidV4" },
        "supportedVersions": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" } }
      },
      "additionalProperties": false
    },
    "helloAckPayload": {
      "type": "object",
      "required": ["selectedVersion", "agentId"],
      "properties": { "selectedVersion": { "const": "0.2" }, "agentId": { "$ref": "#/$defs/uuidV4" } },
      "additionalProperties": false
    },
    "pairingRequestPayload": { "type": "object", "required": ["pairingCode"], "properties": { "pairingCode": { "$ref": "#/$defs/base64url16" } }, "additionalProperties": false },
    "pairingResultPayload": {
      "type": "object",
      "required": ["credentialId", "credentialSecret", "credentialExpiresAt"],
      "properties": {
        "credentialId": { "$ref": "#/$defs/uuidV4" },
        "credentialSecret": { "$ref": "#/$defs/base64url32" },
        "credentialExpiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "authChallengePayload": {
      "type": "object",
      "required": ["challengeId", "challenge", "expiresAt"],
      "properties": { "challengeId": { "$ref": "#/$defs/uuidV4" }, "challenge": { "$ref": "#/$defs/base64url32" }, "expiresAt": { "$ref": "#/$defs/timestamp" } },
      "additionalProperties": false
    },
    "authResponsePayload": {
      "type": "object",
      "required": ["challengeId", "credentialId", "proof"],
      "properties": { "challengeId": { "$ref": "#/$defs/uuidV4" }, "credentialId": { "$ref": "#/$defs/uuidV4" }, "proof": { "$ref": "#/$defs/base64url32" } },
      "additionalProperties": false
    },
    "authResultPayload": {
      "type": "object",
      "required": ["authenticated", "authorizationExpiresAt"],
      "properties": { "authenticated": { "const": true }, "authorizationExpiresAt": { "$ref": "#/$defs/timestamp" } },
      "additionalProperties": false
    },
    "openSessionPayload": {
      "type": "object",
      "required": ["shell", "dimensions"],
      "properties": { "shell": { "const": "powershell" }, "dimensions": { "$ref": "#/$defs/dimensions" } },
      "additionalProperties": false
    },
    "sessionIdPayload": { "type": "object", "required": ["sessionId"], "properties": { "sessionId": { "$ref": "#/$defs/sessionId" } }, "additionalProperties": false },
    "reopenSessionPayload": {
      "type": "object",
      "required": ["sessionId", "dimensions"],
      "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "dimensions": { "$ref": "#/$defs/dimensions" } },
      "additionalProperties": false
    },
    "terminalInputPayload": {
      "type": "object",
      "required": ["sessionId", "data"],
      "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "data": { "$ref": "#/$defs/base64urlData" } },
      "additionalProperties": false
    },
    "terminalOutputPayload": {
      "type": "object",
      "required": ["sessionId", "offset", "data"],
      "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "offset": { "$ref": "#/$defs/offset" }, "data": { "$ref": "#/$defs/base64urlData" } },
      "additionalProperties": false
    },
    "historyBeginPayload": {
      "type": "object",
      "required": ["sessionId", "startOffset", "endOffset", "truncated"],
      "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "startOffset": { "$ref": "#/$defs/offset" }, "endOffset": { "$ref": "#/$defs/offset" }, "truncated": { "type": "boolean" } },
      "additionalProperties": false
    },
    "historyChunkPayload": {
      "type": "object",
      "required": ["sessionId", "offset", "data"],
      "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "offset": { "$ref": "#/$defs/offset" }, "data": { "$ref": "#/$defs/base64urlData" } },
      "additionalProperties": false
    },
    "historyEndPayload": {
      "type": "object",
      "required": ["sessionId", "endOffset"],
      "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "endOffset": { "$ref": "#/$defs/offset" } },
      "additionalProperties": false
    },
    "resizePayload": {
      "type": "object",
      "required": ["sessionId", "dimensions"],
      "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "dimensions": { "$ref": "#/$defs/dimensions" } },
      "additionalProperties": false
    },
    "heartbeatPayload": { "type": "object", "required": ["kind", "nonce"], "properties": { "kind": { "enum": ["ping", "pong"] }, "nonce": { "$ref": "#/$defs/base64url16" } }, "additionalProperties": false },
    "closeSessionPayload": { "type": "object", "required": ["sessionId", "reason"], "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "reason": { "enum": ["user_request", "new_session"] } }, "additionalProperties": false },
    "sessionClosedPayload": { "type": "object", "required": ["sessionId", "reason"], "properties": { "sessionId": { "$ref": "#/$defs/sessionId" }, "reason": { "enum": ["user_request", "new_session", "credential_expired", "credential_revoked", "agent_shutdown", "process_exit", "protocol_error", "backpressure_limit"] } }, "additionalProperties": false },
    "errorPayload": {
      "type": "object",
      "required": ["code", "fatal"],
      "properties": { "code": { "enum": ["INVALID_JSON", "SCHEMA_INVALID", "UNSUPPORTED_VERSION", "UNKNOWN_TYPE", "FRAME_TOO_LARGE", "PAYLOAD_TOO_LARGE", "SEQUENCE_REPLAY", "SEQUENCE_GAP", "OUTPUT_OFFSET_INVALID", "INVALID_STATE", "DIRECTION_VIOLATION", "ORIGIN_REJECTED", "PAIRING_FAILED", "AUTHENTICATION_FAILED", "AUTHORIZATION_EXPIRED", "SESSION_REOPEN_REJECTED", "HELLO_TIMEOUT", "HEARTBEAT_TIMEOUT", "SESSION_OPEN_FAILED", "BACKPRESSURE_LIMIT"] }, "fatal": { "const": true } },
      "additionalProperties": false
    },
    "helloFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "hello" }, "payload": { "$ref": "#/$defs/helloPayload" } } }] },
    "helloAckFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "hello_ack" }, "payload": { "$ref": "#/$defs/helloAckPayload" } } }] },
    "pairingRequestFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "pairing_request" }, "payload": { "$ref": "#/$defs/pairingRequestPayload" } } }] },
    "pairingResultFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "pairing_result" }, "payload": { "$ref": "#/$defs/pairingResultPayload" } } }] },
    "authChallengeFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "auth_challenge" }, "payload": { "$ref": "#/$defs/authChallengePayload" } } }] },
    "authResponseFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "auth_response" }, "payload": { "$ref": "#/$defs/authResponsePayload" } } }] },
    "authResultFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "auth_result" }, "payload": { "$ref": "#/$defs/authResultPayload" } } }] },
    "openSessionFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "open_session" }, "payload": { "$ref": "#/$defs/openSessionPayload" } } }] },
    "sessionOpenedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_opened" }, "payload": { "$ref": "#/$defs/sessionIdPayload" } } }] },
    "reopenSessionFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "reopen_session" }, "payload": { "$ref": "#/$defs/reopenSessionPayload" } } }] },
    "sessionReopenedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_reopened" }, "payload": { "$ref": "#/$defs/sessionIdPayload" } } }] },
    "historyBeginFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "history_begin" }, "payload": { "$ref": "#/$defs/historyBeginPayload" } } }] },
    "historyChunkFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "history_chunk" }, "payload": { "$ref": "#/$defs/historyChunkPayload" } } }] },
    "historyEndFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "history_end" }, "payload": { "$ref": "#/$defs/historyEndPayload" } } }] },
    "terminalInputFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "terminal_input" }, "payload": { "$ref": "#/$defs/terminalInputPayload" } } }] },
    "terminalOutputFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "terminal_output" }, "payload": { "$ref": "#/$defs/terminalOutputPayload" } } }] },
    "resizeFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "resize" }, "payload": { "$ref": "#/$defs/resizePayload" } } }] },
    "heartbeatFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "heartbeat" }, "payload": { "$ref": "#/$defs/heartbeatPayload" } } }] },
    "detachFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "detach" }, "payload": { "$ref": "#/$defs/sessionIdPayload" } } }] },
    "sessionDetachedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_detached" }, "payload": { "$ref": "#/$defs/sessionIdPayload" } } }] },
    "closeSessionFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "close_session" }, "payload": { "$ref": "#/$defs/closeSessionPayload" } } }] },
    "sessionClosedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_closed" }, "payload": { "$ref": "#/$defs/sessionClosedPayload" } } }] },
    "errorFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "error" }, "payload": { "$ref": "#/$defs/errorPayload" } } }] }
  }
}
