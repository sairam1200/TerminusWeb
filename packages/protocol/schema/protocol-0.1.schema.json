{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminus.invalid/contracts/protocol-0.1.schema.json",
  "title": "Terminus private terminal protocol 0.1",
  "description": "Closed JSON frame vocabulary. Direction, sequence history, decoded byte limits, timing, proof validation, and state transitions are enforced by companion contracts.",
  "oneOf": [
    { "$ref": "#/$defs/helloFrame" },
    { "$ref": "#/$defs/helloAckFrame" },
    { "$ref": "#/$defs/pairingRequestFrame" },
    { "$ref": "#/$defs/pairingResultFrame" },
    { "$ref": "#/$defs/authChallengeFrame" },
    { "$ref": "#/$defs/authResponseFrame" },
    { "$ref": "#/$defs/authResultFrame" },
    { "$ref": "#/$defs/openSessionFrame" },
    { "$ref": "#/$defs/sessionOpenedFrame" },
    { "$ref": "#/$defs/terminalInputFrame" },
    { "$ref": "#/$defs/terminalOutputFrame" },
    { "$ref": "#/$defs/resizeFrame" },
    { "$ref": "#/$defs/heartbeatFrame" },
    { "$ref": "#/$defs/detachFrame" },
    { "$ref": "#/$defs/sessionDetachedFrame" },
    { "$ref": "#/$defs/resumeSessionFrame" },
    { "$ref": "#/$defs/sessionResumedFrame" },
    { "$ref": "#/$defs/closeSessionFrame" },
    { "$ref": "#/$defs/sessionClosedFrame" },
    { "$ref": "#/$defs/errorFrame" }
  ],
  "$defs": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "base64url16": {
      "type": "string",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "base64url32": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "base64urlData": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "dimensions": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "baseFrame": {
      "type": "object",
      "required": ["version", "type", "connectionId", "sequence", "payload"],
      "properties": {
        "version": { "const": "0.1" },
        "type": {
          "enum": [
            "hello", "hello_ack", "pairing_request", "pairing_result",
            "auth_challenge", "auth_response", "auth_result", "open_session",
            "session_opened", "terminal_input", "terminal_output", "resize",
            "heartbeat", "detach", "session_detached", "resume_session",
            "session_resumed", "close_session", "session_closed", "error"
          ]
        },
        "connectionId": { "$ref": "#/$defs/uuidV4" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "helloPayload": {
      "type": "object",
      "required": ["clientInstanceId", "supportedVersions"],
      "properties": {
        "clientInstanceId": { "$ref": "#/$defs/uuidV4" },
        "credentialId": { "$ref": "#/$defs/uuidV4" },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      },
      "additionalProperties": false
    },
    "helloAckPayload": {
      "type": "object",
      "required": ["selectedVersion", "agentId"],
      "properties": {
        "selectedVersion": { "const": "0.1" },
        "agentId": { "$ref": "#/$defs/uuidV4" }
      },
      "additionalProperties": false
    },
    "pairingRequestPayload": {
      "type": "object",
      "required": ["pairingCode"],
      "properties": { "pairingCode": { "$ref": "#/$defs/base64url16" } },
      "additionalProperties": false
    },
    "pairingResultPayload": {
      "type": "object",
      "required": ["credentialId", "credentialSecret", "credentialExpiresAt"],
      "properties": {
        "credentialId": { "$ref": "#/$defs/uuidV4" },
        "credentialSecret": { "$ref": "#/$defs/base64url32" },
        "credentialExpiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "authChallengePayload": {
      "type": "object",
      "required": ["challengeId", "challenge", "expiresAt"],
      "properties": {
        "challengeId": { "$ref": "#/$defs/uuidV4" },
        "challenge": { "$ref": "#/$defs/base64url32" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "authResponsePayload": {
      "type": "object",
      "required": ["challengeId", "credentialId", "proof"],
      "properties": {
        "challengeId": { "$ref": "#/$defs/uuidV4" },
        "credentialId": { "$ref": "#/$defs/uuidV4" },
        "proof": { "$ref": "#/$defs/base64url32" }
      },
      "additionalProperties": false
    },
    "authResultPayload": {
      "type": "object",
      "required": ["authenticated", "authorizationExpiresAt"],
      "properties": {
        "authenticated": { "const": true },
        "authorizationExpiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "openSessionPayload": {
      "type": "object",
      "required": ["shell", "dimensions"],
      "properties": {
        "shell": { "const": "powershell" },
        "dimensions": { "$ref": "#/$defs/dimensions" }
      },
      "additionalProperties": false
    },
    "sessionIdOnlyPayload": {
      "type": "object",
      "required": ["sessionId"],
      "properties": { "sessionId": { "$ref": "#/$defs/uuidV4" } },
      "additionalProperties": false
    },
    "terminalPayload": {
      "type": "object",
      "required": ["sessionId", "data"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuidV4" },
        "data": { "$ref": "#/$defs/base64urlData" }
      },
      "additionalProperties": false
    },
    "resizePayload": {
      "type": "object",
      "required": ["sessionId", "dimensions"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuidV4" },
        "dimensions": { "$ref": "#/$defs/dimensions" }
      },
      "additionalProperties": false
    },
    "heartbeatPayload": {
      "type": "object",
      "required": ["kind", "nonce"],
      "properties": {
        "kind": { "enum": ["ping", "pong"] },
        "nonce": { "$ref": "#/$defs/base64url16" }
      },
      "additionalProperties": false
    },
    "sessionDetachedPayload": {
      "type": "object",
      "required": ["sessionId", "resumeGrant", "expiresAt"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuidV4" },
        "resumeGrant": { "$ref": "#/$defs/base64url32" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "resumeSessionPayload": {
      "type": "object",
      "required": ["sessionId", "resumeGrant", "dimensions"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuidV4" },
        "resumeGrant": { "$ref": "#/$defs/base64url32" },
        "dimensions": { "$ref": "#/$defs/dimensions" }
      },
      "additionalProperties": false
    },
    "closeSessionPayload": {
      "type": "object",
      "required": ["sessionId", "reason"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuidV4" },
        "reason": { "const": "user_request" }
      },
      "additionalProperties": false
    },
    "sessionClosedPayload": {
      "type": "object",
      "required": ["sessionId", "reason"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuidV4" },
        "reason": { "enum": ["user_request", "idle_timeout", "agent_shutdown", "process_exit", "protocol_error", "backpressure_limit"] }
      },
      "additionalProperties": false
    },
    "errorPayload": {
      "type": "object",
      "required": ["code", "fatal"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_JSON", "SCHEMA_INVALID", "UNSUPPORTED_VERSION", "UNKNOWN_TYPE",
            "FRAME_TOO_LARGE", "PAYLOAD_TOO_LARGE", "SEQUENCE_REPLAY", "SEQUENCE_GAP",
            "INVALID_STATE", "DIRECTION_VIOLATION", "ORIGIN_REJECTED", "PAIRING_FAILED",
            "AUTHENTICATION_FAILED", "AUTHORIZATION_EXPIRED", "RESUME_REJECTED",
            "HELLO_TIMEOUT", "HEARTBEAT_TIMEOUT", "SESSION_OPEN_FAILED", "BACKPRESSURE_LIMIT"
          ]
        },
        "fatal": { "const": true }
      },
      "additionalProperties": false
    },
    "helloFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "hello" }, "payload": { "$ref": "#/$defs/helloPayload" } } }] },
    "helloAckFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "hello_ack" }, "payload": { "$ref": "#/$defs/helloAckPayload" } } }] },
    "pairingRequestFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "pairing_request" }, "payload": { "$ref": "#/$defs/pairingRequestPayload" } } }] },
    "pairingResultFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "pairing_result" }, "payload": { "$ref": "#/$defs/pairingResultPayload" } } }] },
    "authChallengeFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "auth_challenge" }, "payload": { "$ref": "#/$defs/authChallengePayload" } } }] },
    "authResponseFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "auth_response" }, "payload": { "$ref": "#/$defs/authResponsePayload" } } }] },
    "authResultFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "auth_result" }, "payload": { "$ref": "#/$defs/authResultPayload" } } }] },
    "openSessionFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "open_session" }, "payload": { "$ref": "#/$defs/openSessionPayload" } } }] },
    "sessionOpenedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_opened" }, "payload": { "$ref": "#/$defs/sessionIdOnlyPayload" } } }] },
    "terminalInputFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "terminal_input" }, "payload": { "$ref": "#/$defs/terminalPayload" } } }] },
    "terminalOutputFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "terminal_output" }, "payload": { "$ref": "#/$defs/terminalPayload" } } }] },
    "resizeFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "resize" }, "payload": { "$ref": "#/$defs/resizePayload" } } }] },
    "heartbeatFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "heartbeat" }, "payload": { "$ref": "#/$defs/heartbeatPayload" } } }] },
    "detachFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "detach" }, "payload": { "$ref": "#/$defs/sessionIdOnlyPayload" } } }] },
    "sessionDetachedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_detached" }, "payload": { "$ref": "#/$defs/sessionDetachedPayload" } } }] },
    "resumeSessionFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "resume_session" }, "payload": { "$ref": "#/$defs/resumeSessionPayload" } } }] },
    "sessionResumedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_resumed" }, "payload": { "$ref": "#/$defs/sessionIdOnlyPayload" } } }] },
    "closeSessionFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "close_session" }, "payload": { "$ref": "#/$defs/closeSessionPayload" } } }] },
    "sessionClosedFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "session_closed" }, "payload": { "$ref": "#/$defs/sessionClosedPayload" } } }] },
    "errorFrame": { "allOf": [{ "$ref": "#/$defs/baseFrame" }, { "properties": { "type": { "const": "error" }, "payload": { "$ref": "#/$defs/errorPayload" } } }] }
  }
}
