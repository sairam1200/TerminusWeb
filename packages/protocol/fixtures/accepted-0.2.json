  "pageLifecycleCases": [
    {
      "id": "v02-page-new-session-success-replaces-fragment-after-open",
      "initialFragment": "#/s/k7m4-p2q9-wxyz",
      "closeAcknowledged": true,
      "newOpenAttempted": true,
      "openedSessionId": "rstv-wxyz-2345",
      "expected": { "fragment": "#/s/rstv-wxyz-2345", "oldReopenCode": "SESSION_REOPEN_REJECTED", "state": "connected" }
    },
    {
      "id": "v02-page-new-session-open-failure-keeps-old-fragment",
      "initialFragment": "#/s/k7m4-p2q9-wxyz",
      "closeAcknowledged": true,
      "newOpenAttempted": true,
      "openFailed": true,
      "expected": { "fragment": "#/s/k7m4-p2q9-wxyz", "oldReopenCode": "SESSION_REOPEN_REJECTED", "state": "closed_error" }
    },
    {
      "id": "v02-page-new-session-close-failure-does-not-open-or-replace",
      "initialFragment": "#/s/k7m4-p2q9-wxyz",
      "closeAcknowledged": false,
      "newOpenAttempted": false,
      "expected": { "fragment": "#/s/k7m4-p2q9-wxyz", "state": "new_session_error" }
    }
  ],
  "retentionCases": [
    {
      "id": "v02-per-session-history-evicts-oldest-byte",
      "initial": [{ "sessionId": "abcd-efgh-jkmn", "startOffset": 0, "bytes": 262144 }],
      "append": { "sessionId": "abcd-efgh-jkmn", "bytes": 1 },
      "expected": [{ "sessionId": "abcd-efgh-jkmn", "startOffset": 1, "bytes": 262144, "truncated": true }]
    },
    {
      "id": "v02-agent-history-budget-evicts-globally-oldest-byte",
      "uniformInitial": { "sessionCount": 64, "bytesEach": 262144, "startOffset": 0 },
      "appendNewSessionBytes": 1,
      "expectedUniform": { "sessionCount": 65, "agentBytes": 16777216, "oldestStartOffset": 1, "oldestBytes": 262143, "oldestTruncated": true, "newestBytes": 1, "closedSessions": 0 }
    },
    {
      "id": "v02-history-within-budgets-does-not-evict-or-close",
      "initial": [{ "sessionId": "abcd-efgh-jkmn", "startOffset": 0, "bytes": 10 }],
      "append": { "sessionId": "abcd-efgh-jkmn", "bytes": 5 },
      "expected": [{ "sessionId": "abcd-efgh-jkmn", "startOffset": 0, "bytes": 15, "truncated": false }]
    }
  ]
