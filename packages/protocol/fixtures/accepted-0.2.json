        { "direction": "agent_to_client", "frame": { "version": "0.2", "type": "history_begin", "connectionId": "10000000-0000-4000-8000-000000000002", "sequence": 1, "payload": { "sessionId": "k7m4-p2q9-wxyz", "startOffset": 100, "endOffset": 104, "truncated": true } } },
