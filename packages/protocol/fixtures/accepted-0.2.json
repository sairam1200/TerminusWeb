        { "direction": "client_to_agent", "frame": { "version": "0.2", "type": "close_session", "connectionId": "10000000-0000-4000-8000-000000000004", "sequence": 0, "payload": { "sessionId": "k7m4-p2q9-wxyz", "reason": "new_session" } } },
