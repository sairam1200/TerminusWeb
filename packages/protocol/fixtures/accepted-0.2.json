        { "direction": "agent_to_client", "frame": { "version": "0.2", "type": "session_reopened", "connectionId": "10000000-0000-4000-8000-000000000003", "sequence": 0, "payload": { "sessionId": "abcd-efgh-jkmn" } } },
        { "direction": "agent_to_client", "frame": { "version": "0.2", "type": "history_begin", "connectionId": "10000000-0000-4000-8000-000000000003", "sequence": 1, "payload": { "sessionId": "abcd-efgh-jkmn", "startOffset": 0, "endOffset": 0, "truncated": false } } },
