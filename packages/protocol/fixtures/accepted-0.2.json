        { "direction": "agent_to_client", "frame": { "version": "0.2", "type": "terminal_output", "connectionId": "10000000-0000-4000-8000-000000000002", "sequence": 5, "payload": { "sessionId": "k7m4-p2q9-wxyz", "offset": 104, "data": "AP8" } } }
